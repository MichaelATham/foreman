# One of these (Anthropic is used if both are set; override with FOREMAN_PROVIDER=openai)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# optional
# FOREMAN_PROVIDER=anthropic|openai
# FOREMAN_MODEL=gpt-6.1-sol        # OpenAI default; gpt-6-astra for best results. Anthropic default: claude-sonnet-4-5
# FOREMAN_REASONING=medium         # OpenAI reasoning effort: none|low|medium|high|xhigh|max
# FOREMAN_FAKE_MODEL=1             # offline demo: replays the scripted session
